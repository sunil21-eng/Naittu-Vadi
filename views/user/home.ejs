            transition: all 0.2s ease;
        }

        .wishlist-btn:hover {
            transform: scale(1.1);
            background: #fff0f0;
        }

        /* Stock status badge styling */
        .stock-status .text-success,
        .stock-status .text-danger {
            font-weight: 500;
            letter-spacing: 0.3px;
        }

        /* Offer badge pulse animation refinement */
        @keyframes gentlePulse {
            0% {
                opacity: 0.95;
                transform: scale(1);
            }
            50% {
                opacity: 1;
                transform: scale(1.02);
            }
            100% {
                opacity: 0.95;
                transform: scale(1);
            }
        }

        .offer-badge {
            animation: gentlePulse 2s infinite;
        }

        /* ========== SIDEBAR FILTER LAYOUT (Amazon/Flipkart style) ========== */
        /* Added purely for layout/UX - no functional/theme changes */

        .shop-layout {
            display: flex;
            align-items: flex-start;
            gap: 24px;
        }

        .filters-sidebar {
            width: 280px;
            flex: 0 0 280px;
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            padding: 0;
            position: sticky;
            top: 15px;
            align-self: flex-start;
            max-height: calc(100vh - 30px);
            overflow-y: auto;
        }

        .filters-sidebar-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 18px;
            border-bottom: 1px solid #eef0f3;
        }

        .filters-sidebar-header h4 {
            margin: 0;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--dark-color);
        }

        .filters-sidebar-header .clear-link {
            font-size: 0.82rem;
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 600;
            cursor: pointer;
            background: none;
            border: none;
        }

        .filters-sidebar-header .clear-link:hover {
            text-decoration: underline;
        }

        .filter-group {
            padding: 16px 18px;
            border-bottom: 1px solid #eef0f3;
        }

        .filter-group:last-child {
            border-bottom: none;
        }

        .filter-group-title {
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            color: var(--dark-color);
            margin-bottom: 14px;
        }

        /* Price range slider block */
        .price-slider-wrap {
            padding: 6px 4px 4px;
        }

        #priceRangeSlider {
            margin: 10px 4px 18px;
        }

        #priceRangeSlider .noUi-connect {
            background: var(--primary-color);
        }

        #priceRangeSlider .noUi-handle {
            border-color: var(--primary-color);
            box-shadow: none;
        }

        .price-range-display {
            font-size: 0.9rem;
            color: #495057;
        }

        .price-range-display strong {
            color: var(--dark-color);
        }

        .btn-apply-price {
            margin-top: 14px;
            width: 100%;
            font-size: 0.85rem;
            padding: 0.5rem 0.6rem;
            border-radius: 20px;
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            color: #fff;
            font-weight: 600;
        }

        .btn-apply-price:hover {
            background-color: #3800d1;
            border-color: #3800d1;
            color: #fff;
        }

        /* Plain visible filter link lists (category / attribute) */
        .filter-link-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .filter-link-list li {
            margin-bottom: 12px;
        }

        .filter-link-list li:last-child {
            margin-bottom: 0;
        }

        .filter-link {
            display: block;
            color: #495057;
            font-size: 0.95rem;
            text-decoration: none;
            cursor: pointer;
        }

        .filter-link:hover {
            color: var(--primary-color);
        }

        .filter-link.active {
            color: var(--primary-color);
            font-weight: 700;
        }

        .filter-link.active:before {
            content: '\f00c';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            font-size: 0.7rem;
            margin-right: 7px;
        }

        /* Category -> Attribute nested tree (Attributes merged under each
           Product Category, always visible, no selection-based hiding) */
        .categories-tree .category-item {
            margin-bottom: 10px;
        }

        .categories-tree .category-link {
            font-weight: 600;
        }

        .attribute-sublist {
            list-style: none;
            margin: 8px 0 0 0;
            padding-left: 16px;
            border-left: 2px solid #eef0f3;
        }

        .attribute-sublist li {
            margin-bottom: 8px;
        }

        .attribute-sublist li:last-child {
            margin-bottom: 0;
        }

        .attribute-link {
            font-size: 0.88rem;
            color: #6c757d;
        }

        .attribute-link:before {
            content: '\f105';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            font-size: 0.7rem;
            margin-right: 6px;
            color: #b9bfc7;
        }

        .attribute-link.active {
            color: var(--primary-color);
        }

        .attribute-link.active:before {
            color: var(--primary-color);
        }

        .shop-content {
            flex: 1;
            min-width: 0;
        }

        .shop-toolbar {
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            padding: 14px 18px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            justify-content: space-between;
        }

        .shop-toolbar .results-count {
            font-size: 0.9rem;
            color: #6c757d;
            margin: 0;
            white-space: nowrap;
        }

        .shop-toolbar .toolbar-controls {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .shop-toolbar .toolbar-controls .form-select {
            font-size: 0.88rem;
            width: auto;
        }

        .toolbar-search {
            flex: 1 1 260px;
            min-width: 220px;
        }

        #ajaxLoadingOverlay {
            display: none;
            text-align: center;
            padding: 60px 0;
        }

        #productsContainer.ajax-loading {
            position: relative;
            min-height: 200px;
            opacity: 0.5;
            pointer-events: none;
            transition: opacity 0.2s ease;
        }

        /* Sidebar stays visible on all screen sizes - it simply stacks
           above the product grid on narrower viewports, Amazon/Flipkart
           style, instead of hiding behind a toggle/drawer. */
        @media (max-width: 991px) {
            .shop-layout {
                flex-direction: column;
            }

            .filters-sidebar {
                width: 100%;
                flex: 0 0 auto;
                position: relative;
                top: 0;
                max-height: none;
                overflow-y: visible;
            }
        }

        /* ========== GROUPED CATEGORY SECTIONS ========== */
        .category-section {
            border-bottom: 2px solid #f0f0f0;
            padding-bottom: 30px;
            margin-bottom: 30px;
        }

        .category-title {
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--dark-color);
        }

        .category-title i {
            font-size: 1.3rem;
        }
    </style>
</head>

<body>
    <%- include("../partials/user/header.ejs") %>

    <!-- Toast Notification -->
    <div id="toast" class="toast-notification">
        <i class="fas"></i>
        <span></span>
    </div>

    <!-- Login Prompt Modal -->
    <div class="modal fade login-prompt-modal" id="loginPromptModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-sign-in-alt me-2"></i>Login Required
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="fas fa-heart-broken fa-3x text-danger mb-3"></i>
                    <h5 class="mb-3">Please login to continue</h5>
                    <p class="text-muted">You need to be logged in to add items to cart or wishlist.</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <a href="/login" class="btn btn-primary px-4">
                        <i class="fas fa-sign-in-alt me-2"></i>Login Now
                    </a>
                    <a href="/signup" class="btn btn-outline-secondary px-4">
                        <i class="fas fa-user-plus me-2"></i>Create Account
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container">

        <h2 class="section-title" id="products">Our Products</h2>

        <%
            // Resolve the human-readable category name for the selected
            // category id, so the sidebar/active-filter chip shows the
            // name instead of the raw category id.
            var selectedCategoryName = '';
            if (currentFilters.category) {
                var _matchedCat = categories.find(function(c) { return String(c._id) === String(currentFilters.category); });
                selectedCategoryName = _matchedCat ? _matchedCat.name : currentFilters.category;
            }

            // Categories displayed alphabetically (A-Z) in the sidebar
            var sortedCategories = categories.slice().sort(function(a, b) {
                return String(a.name || '').localeCompare(String(b.name || ''));
            });
        %>

        <div class="shop-layout">

            <!-- ============ SIDEBAR FILTERS (Flipkart / Amazon style, always visible) ============ -->
            <aside class="filters-sidebar" id="filtersSidebar">
                <div class="filters-sidebar-header">
                    <h4><i class="fas fa-filter me-2"></i>Filters</h4>
                    <button type="button" class="clear-link" onclick="clearAllFilters()">Clear All</button>
                </div>

                <!-- Active Filters -->
                <div class="filter-group" id="activeFiltersGroup" <%= (currentFilters.category || currentFilters.categoryAttribute || currentFilters.minPrice || currentFilters.maxPrice || currentFilters.search) ? '' : 'style="display:none;"' %>>
                    <div class="filter-group-title">Active Filters</div>
                    <div class="active-filters" id="activeFiltersBody">
                        <% if (currentFilters.category) { %>
                            <span class="filter-badge">
                                Category: <%= selectedCategoryName %> <span class="close" onclick="removeFilter('category')">&times;</span>
                            </span>
                        <% } %>
                        <% if (currentFilters.categoryAttribute) { %>
                            <span class="filter-badge">
                                Attribute: <%= currentFilters.categoryAttribute %> <span class="close" onclick="removeFilter('categoryAttribute')">&times;</span>
                            </span>
                        <% } %>
                        <% if (currentFilters.minPrice || currentFilters.maxPrice) { %>
                            <span class="filter-badge">
                                Price: ₹<%= currentFilters.minPrice || '0' %> - ₹<%= currentFilters.maxPrice || 'Any' %>
                                <span class="close" onclick="removePriceFilter()">&times;</span>
                            </span>
                        <% } %>
                        <% if (currentFilters.search) { %>
                            <span class="filter-badge">
                                Search: <%= currentFilters.search %> <span class="close" onclick="removeFilter('search')">&times;</span>
                            </span>
                        <% } %>
                    </div>
                </div>

                <form id="filterForm">
                    <input type="hidden" name="page" value="1">

                    <!-- Price range slider -->
                    <div class="filter-group">
                        <div class="filter-group-title">Price</div>
                        <div class="price-slider-wrap">
                            <div class="price-range-display" id="priceRangeDisplay">
                                Price: <strong>₹<span id="priceMinLabel"><%= currentFilters.minPrice || 0 %></span></strong>
                                — <strong>₹<span id="priceMaxLabel"><%= currentFilters.maxPrice || 5000 %></span></strong>
                            </div>
                            <div id="priceRangeSlider"></div>
                            <button type="button" class="btn btn-apply-price" onclick="applyPriceFilter()">Filter</button>
                        </div>
                    </div>

                    <!-- Category (alphabetically sorted A-Z) with its Attributes
                         nested directly underneath it. Every category and every
                         attribute stays visible at all times - nothing is
                         hidden or shown based on the current selection. -->
                    <div class="filter-group">
                        <div class="filter-group-title">Product Categories</div>
                        <ul class="filter-link-list categories-tree" id="categoryList">
                            <li>
                                <a href="javascript:void(0)" class="filter-link <%= !currentFilters.category ? 'active' : '' %>" onclick="selectFilter('category', '', this)">All Categories</a>
                            </li>
                            <% sortedCategories.forEach(function(cat) { %>
                                <% var catAttrs = attributesByCategory[String(cat._id)] || []; %>
                                <li class="category-item">
                                    <a href="javascript:void(0)" class="filter-link category-link <%= (String(currentFilters.category) === String(cat._id) && !currentFilters.categoryAttribute) ? 'active' : '' %>" onclick="selectCategory('<%= cat._id %>', this)">
                                        <%= cat.name %>
                                    </a>
                                    <% if (catAttrs.length > 0) { %>
                                        <ul class="filter-link-list attribute-sublist">
                                            <% catAttrs.forEach(function(attr) { %>
                                                <li>
                                                    <a href="javascript:void(0)" class="filter-link attribute-link <%= (String(currentFilters.category) === String(cat._id) && currentFilters.categoryAttribute === attr) ? 'active' : '' %>" onclick="selectCategoryAttribute('<%= cat._id %>', '<%= attr %>', this)">
                                                        <%= attr %>
                                                    </a>
                                                </li>
                                            <% }); %>
                                        </ul>
                                    <% } %>
                                </li>
                            <% }); %>
                        </ul>
                    </div>

                    <!-- hidden inputs driving the filter state -->
                    <input type="hidden" id="category" name="category" value="<%= currentFilters.category %>">
                    <input type="hidden" id="categoryAttribute" name="categoryAttribute" value="<%= currentFilters.categoryAttribute %>">
                    <input type="hidden" id="minPrice" name="minPrice" value="<%= currentFilters.minPrice %>">
                    <input type="hidden" id="maxPrice" name="maxPrice" value="<%= currentFilters.maxPrice %>">
                    <input type="hidden" id="search" name="search" value="<%= currentFilters.search %>">
                    <input type="hidden" id="sortBy" name="sortBy" value="<%= currentFilters.sortBy %>">
                    <input type="hidden" id="limit" name="limit" value="<%= currentFilters.limit %>">
                </form>
            </aside>

            <!-- ============ PRODUCT CONTENT AREA ============ -->
            <div class="shop-content">

                <!-- Toolbar: search + sort + count -->
                <div class="shop-toolbar">
                    <p class="results-count" id="resultsCount">
                        <% if (products && products.length > 0) { %>
                            Showing <%= products.length %> product<%= products.length !== 1 ? 's' : '' %>
                        <% } else { %>
                            No products found
                        <% } %>
                    </p>

                    <div class="toolbar-controls">
                        <div class="input-group search-container toolbar-search">
                            <input type="text" class="form-control" id="toolbarSearch" value="<%= currentFilters.search %>" placeholder="Search products...">
                            <button type="button" class="clear-search-btn" id="clearSearch" onclick="clearSearchField()" title="Clear search">
                                <i class="fas fa-times"></i>
                            </button>
                            <button class="btn btn-outline-primary" type="button" onclick="applyFilters(true)">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>

                        <!-- Default listing is oldest-first (createdAt ascending) -->
                        <select class="form-select" id="toolbarSortBy">
                            <option value="oldest" <%= (!currentFilters.sortBy || currentFilters.sortBy == 'oldest') ? 'selected' : '' %>>Oldest First</option>
                            <option value="newest" <%= currentFilters.sortBy == 'newest' ? 'selected' : '' %>>Newest First</option>
                            <option value="price_low" <%= currentFilters.sortBy == 'price_low' ? 'selected' : '' %>>Price: Low to High</option>
                            <option value="price_high" <%= currentFilters.sortBy == 'price_high' ? 'selected' : '' %>>Price: High to Low</option>
                            <option value="name_asc" <%= currentFilters.sortBy == 'name_asc' ? 'selected' : '' %>>Name: A to Z</option>
                            <option value="name_desc" <%= currentFilters.sortBy == 'name_desc' ? 'selected' : '' %>>Name: Z to A</option>
                            <option value="popularity" <%= currentFilters.sortBy == 'popularity' ? 'selected' : '' %>>Popularity</option>
                        </select>

                        <select class="form-select" id="toolbarLimit">
                            <option value="30" <%= currentFilters.limit == 30 ? 'selected' : '' %>>30 Items</option>
                            <option value="60" <%= currentFilters.limit == 60 ? 'selected' : '' %>>60 Items</option>
                            <option value="90" <%= currentFilters.limit == 90 ? 'selected' : '' %>>90 Items</option>
                        </select>
                    </div>
                </div>

                <!-- AJAX-swappable products + pagination -->
                <div id="productsContainer">
                    <% if (isGroupedView) { %>
                        <!-- ========== GROUPED BY CATEGORY (A-Z) ========== -->
                        <% if (products && products.length > 0) { %>
                            <%
                                // Group products by category ID
                                const grouped = {};
                                products.forEach(p => {
                                    const catId = String(p.category ? p.category._id : '');
                                    if (!grouped[catId]) grouped[catId] = [];
                                    grouped[catId].push(p);
                                });
                                // Sort categories alphabetically (already sorted, but ensure)
                                const sortedCatList = categories.slice().sort((a,b) => a.name.localeCompare(b.name));
                            %>
                            <% sortedCatList.forEach(cat => { %>
                                <% const catProducts = grouped[String(cat._id)] || []; %>
                                <% if (catProducts.length > 0) { %>
                                    <section class="category-section">
                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            <h3 class="category-title mb-0">
                                                <i class="fas fa-folder-open me-2 text-primary"></i><%= cat.name %>
                                            </h3>
                                            <span class="badge bg-secondary"><%= catProducts.length %> product<%= catProducts.length > 1 ? 's' : '' %></span>
                                        </div>
                                        <div class="row">
                                            <% catProducts.forEach(product => { %>
                                                <div class="col-lg-4 col-md-4 col-sm-6 col-6 mb-4">
                                                    <!-- PRODUCT CARD - same as flat list -->
                                                    <div class="product-card" onclick="window.location.href='/product/<%= product._id %>'">
                                                        <div class="product-image-container">
                                                            <% if (product.hasOffer && product.discountPercentage > 0) { %>
                                                                <div class="offer-badge"><%= product.discountPercentage %>% OFF</div>
                                                            <% } %>
                                                            <div class="wishlist-btn-container">
                                                                <button class="wishlist-btn" data-product-id="<%= product._id %>" onclick="event.stopPropagation(); toggleWishlist('<%= product._id %>', this)">
                                                                    <i class="far fa-heart"></i>
                                                                </button>
                                                            </div>
                                                            <% if (product.images && product.images.length > 0) { %>
                                                                <img src="https://res.cloudinary.com/dwne1v72e/image/upload/<%= product.images[0] %>" class="product-image card-img-top" alt="<%= product.productName %> - Nattu Vedi & Sivakasi Crackers" loading="lazy" onerror="this.onerror=null; this.src='/images/default-product.png';">
                                                            <% } else { %>
                                                                <div class="no-image-placeholder">
                                                                    <div class="text-center">
                                                                        <i class="fas fa-image fa-3x mb-2"></i>
                                                                        <p class="mb-0">No Image</p>
                                                                    </div>
                                                                </div>
                                                            <% } %>
                                                        </div>
                                                        <div class="product-details">
                                                            <h5 class="product-title">
                                                                <%= product.productName %>
                                                                <% if (product.assured) { %><span class="assured-badge">✓ Assured</span><% } %>
                                                            </h5>
                                                            <p class="product-description">
                                                                <%= product.description ? product.description.substring(0, 60) + (product.description.length > 60 ? '...' : '') : 'No description available' %>
                                                            </p>
                                                            <div class="price-container">
                                                                <% if (product.hasOffer && product.discountPercentage > 0) { %>
                                                                    <span class="original-price">₹<%= Number(product.originalPrice).toLocaleString('en-IN') %></span>
                                                                    <span class="discounted-price">₹<%= Number(product.discountedPrice).toLocaleString('en-IN') %></span>
                                                                    <span class="discount-badge">-<%= product.discountPercentage %>%</span>
                                                                    <% if (product.originalPrice > product.discountedPrice) { %>
                                                                        <div class="price-saved">Save ₹<%= Number(product.originalPrice - product.discountedPrice).toLocaleString('en-IN') %></div>
                                                                    <% } %>
                                                                <% } else if (product.regularPrice && Number(product.regularPrice) > Number(product.salePrice)) { %>
                                                                    <span class="regular-price">₹<%= Number(product.regularPrice).toLocaleString('en-IN') %></span>
                                                                    <span class="sale-price">₹<%= Number(product.salePrice).toLocaleString('en-IN') %></span>
                                                                    <% const discountPercent = Math.round(((Number(product.regularPrice) - Number(product.salePrice)) / Number(product.regularPrice)) * 100); %>
                                                                    <% if (discountPercent > 0) { %><span class="discount-percent">-<%= discountPercent %>%</span><% } %>
                                                                <% } else { %>
                                                                    <span class="sale-price">₹<%= Number(product.salePrice).toLocaleString('en-IN') %></span>
                                                                <% } %>
                                                            </div>
                                                            <% if (product.quantity !== undefined) { %>
                                                                <div class="stock-status">
                                                                    <% if (product.quantity > 0) { %>
                                                                        <small class="text-success"><i class="fas fa-check-circle"></i> In Stock (<%= product.quantity %>)</small>
                                                                    <% } else { %>
                                                                        <small class="text-danger"><i class="fas fa-times-circle"></i> Out of Stock</small>
                                                                    <% } %>
                                                                </div>
                                                            <% } %>
                                                            <div class="category-container">
                                                                <% if (product.category && product.category.name) { %>
                                                                    <span class="category-badge"><%= product.category.name %></span>
                                                                <% } %>
                                                                <% if (product.categoryAttribute) { %>
                                                                    <span class="attribute-badge"><%= product.categoryAttribute %></span>
                                                                <% } %>
                                                                <% if (product.hasOffer && product.discountPercentage > 0) { %>
                                                                    <span class="offer-tag">Special Offer</span>
                                                                <% } %>
                                                            </div>
                                                            <div class="action-buttons">
                                                                <% if (product.quantity > 0) { %>
                                                                    <button class="btn btn-outline-primary btn-sm add-to-cart" data-product-id="<%= product._id %>" onclick="event.stopPropagation(); addToCart('<%= product._id %>', this)">
                                                                        <i class="fas fa-shopping-cart me-1"></i>Add to Cart
                                                                    </button>
                                                                <% } else { %>
                                                                    <button class="btn btn-outline-secondary btn-sm" disabled>
                                                                        <i class="fas fa-times-circle me-1"></i>Out of Stock
                                                                    </button>
                                                                <% } %>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        </div>
                                    </section>
                                <% } %>
                            <% }) %>
                        <% } else { %>
                            <div class="text-center py-5">
                                <i class="fas fa-box-open fa-3x mb-3 text-muted"></i>
                                <h3 class="text-muted">No products found</h3>
                                <p class="text-muted">Please check back later.</p>
                            </div>
                        <% } %>
                    <% } else { %>
                        <!-- ========== FLAT LIST WITH PAGINATION (when filters are active) ========== -->
                        <% if (products && products.length > 0) { %>
                            <div class="row">
                                <% products.forEach(function(product) { %>
                                    <div class="col-lg-4 col-md-4 col-sm-6 col-6 mb-4">
                                        <div class="product-card" onclick="window.location.href='/product/<%= product._id %>'">
                                            <div class="product-image-container">
                                                <% if (product.hasOffer && product.discountPercentage > 0) { %>
                                                    <div class="offer-badge"><%= product.discountPercentage %>% OFF</div>
                                                <% } %>
                                                <div class="wishlist-btn-container">
                                                    <button class="wishlist-btn" data-product-id="<%= product._id %>" onclick="event.stopPropagation(); toggleWishlist('<%= product._id %>', this)">
                                                        <i class="far fa-heart"></i>
                                                    </button>
                                                </div>
                                                <% if (product.images && product.images.length > 0) { %>
                                                    <img src="https://res.cloudinary.com/dwne1v72e/image/upload/<%= product.images[0] %>" class="product-image card-img-top" alt="<%= product.productName %> - Nattu Vedi & Sivakasi Crackers" loading="lazy" onerror="this.onerror=null; this.src='/images/default-product.png';">
                                                <% } else { %>
                                                    <div class="no-image-placeholder">
                                                        <div class="text-center">
                                                            <i class="fas fa-image fa-3x mb-2"></i>
                                                            <p class="mb-0">No Image</p>
                                                        </div>
                                                    </div>
                                                <% } %>
                                            </div>
                                            <div class="product-details">
                                                <h5 class="product-title">
                                                    <%= product.productName %>
                                                    <% if (product.assured) { %><span class="assured-badge">✓ Assured</span><% } %>
                                                </h5>
                                                <p class="product-description">
                                                    <%= product.description ? product.description.substring(0, 60) + (product.description.length > 60 ? '...' : '') : 'No description available' %>
                                                </p>
                                                <div class="price-container">
                                                    <% if (product.hasOffer && product.discountPercentage > 0) { %>
                                                        <span class="original-price">₹<%= Number(product.originalPrice).toLocaleString('en-IN') %></span>
                                                        <span class="discounted-price">₹<%= Number(product.discountedPrice).toLocaleString('en-IN') %></span>
                                                        <span class="discount-badge">-<%= product.discountPercentage %>%</span>
                                                        <% if (product.originalPrice > product.discountedPrice) { %>
                                                            <div class="price-saved">Save ₹<%= Number(product.originalPrice - product.discountedPrice).toLocaleString('en-IN') %></div>
                                                        <% } %>
                                                    <% } else if (product.regularPrice && Number(product.regularPrice) > Number(product.salePrice)) { %>
                                                        <span class="regular-price">₹<%= Number(product.regularPrice).toLocaleString('en-IN') %></span>
                                                        <span class="sale-price">₹<%= Number(product.salePrice).toLocaleString('en-IN') %></span>
                                                        <% const discountPercent = Math.round(((Number(product.regularPrice) - Number(product.salePrice)) / Number(product.regularPrice)) * 100); %>
                                                        <% if (discountPercent > 0) { %><span class="discount-percent">-<%= discountPercent %>%</span><% } %>
                                                    <% } else { %>
                                                        <span class="sale-price">₹<%= Number(product.salePrice).toLocaleString('en-IN') %></span>
                                                    <% } %>
                                                </div>
                                                <% if (product.quantity !== undefined) { %>
                                                    <div class="stock-status">
                                                        <% if (product.quantity > 0) { %>
                                                            <small class="text-success"><i class="fas fa-check-circle"></i> In Stock (<%= product.quantity %>)</small>
                                                        <% } else { %>
                                                            <small class="text-danger"><i class="fas fa-times-circle"></i> Out of Stock</small>
                                                        <% } %>
                                                    </div>
                                                <% } %>
                                                <div class="category-container">
                                                    <% if (product.category && product.category.name) { %>
                                                        <span class="category-badge"><%= product.category.name %></span>
                                                    <% } %>
                                                    <% if (product.categoryAttribute) { %>
                                                        <span class="attribute-badge"><%= product.categoryAttribute %></span>
                                                    <% } %>
                                                    <% if (product.hasOffer && product.discountPercentage > 0) { %>
                                                        <span class="offer-tag">Special Offer</span>
                                                    <% } %>
                                                </div>
                                                <div class="action-buttons">
                                                    <% if (product.quantity > 0) { %>
                                                        <button class="btn btn-outline-primary btn-sm add-to-cart" data-product-id="<%= product._id %>" onclick="event.stopPropagation(); addToCart('<%= product._id %>', this)">
                                                            <i class="fas fa-shopping-cart me-1"></i>Add to Cart
                                                        </button>
                                                    <% } else { %>
                                                        <button class="btn btn-outline-secondary btn-sm" disabled>
                                                            <i class="fas fa-times-circle me-1"></i>Out of Stock
                                                        </button>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                            <!-- Pagination -->
                            <% if (totalPage > 1) { %>
                                <nav aria-label="Page navigation" class="mt-4">
                                    <ul class="pagination">
                                        <% if (currentPage > 1) { %>
                                            <li class="page-item">
                                                <a class="page-link ajax-page-link" href="?page=<%= currentPage-1 %><% for (const key in query) { if (key !== 'page' && query[key] !== '') { %>&<%= key %>=<%= query[key] %><% } } %>" data-page="<%= currentPage-1 %>" aria-label="Previous">
                                                    <span aria-hidden="true">&laquo;</span>
                                                </a>
                                            </li>
                                        <% } %>
                                        <% for (let i = 1; i <= totalPage; i++) { %>
                                            <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                                <a class="page-link ajax-page-link" href="?page=<%= i %><% for (const key in query) { if (key !== 'page' && query[key] !== '') { %>&<%= key %>=<%= query[key] %><% } } %>" data-page="<%= i %>">
                                                    <%= i %>
                                                </a>
                                            </li>
                                        <% } %>
                                        <% if (currentPage < totalPage) { %>
                                            <li class="page-item">
                                                <a class="page-link ajax-page-link" href="?page=<%= currentPage+1 %><% for (const key in query) { if (key !== 'page' && query[key] !== '') { %>&<%= key %>=<%= query[key] %><% } } %>" data-page="<%= currentPage+1 %>" aria-label="Next">
                                                    <span aria-hidden="true">&raquo;</span>
                                                </a>
                                            </li>
                                        <% } %>
                                    </ul>
                                </nav>
                            <% } %>
                        <% } else { %>
                            <div class="text-center py-5">
                                <i class="fas fa-search fa-3x mb-3 text-muted"></i>
                                <h3 class="text-muted">No products found</h3>
                                <p class="text-muted">Try adjusting your filters or search term</p>
                                <a href="/" class="btn btn-primary" id="clearFiltersBtn">Clear Filters</a>
                            </div>
                        <% } %>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Show toast notification
        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            const icon = toast.querySelector('i');
            const text = toast.querySelector('span');

            toast.className = 'toast-notification ' + type;
            icon.className = 'fas ' + (type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle');
            text.textContent = message;

            toast.style.display = 'flex';

            setTimeout(() => {
                toast.style.display = 'none';
            }, 3000);
        }

        // Show login modal
        function showLoginModal() {
            const modal = new bootstrap.Modal(document.getElementById('loginPromptModal'));
            modal.show();
        }

        // Toggle wishlist function with improved error handling
        function toggleWishlist(productId, button) {
            const icon = button.querySelector('i');

            button.disabled = true;
            const originalHTML = button.innerHTML;
            button.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

            fetch('/wishlist/toggle', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ productId: productId })
                })
                .then(async response => {
                    const contentType = response.headers.get('content-type');

                    if (response.status === 401) {
                        showToast('Please login to manage your wishlist', 'error');
                        setTimeout(() => {
                            showLoginModal();
                        }, 1500);
                        button.innerHTML = originalHTML;
                        button.disabled = false;
                        return;
                    }

                    if (response.status === 400) {
                        const data = await response.json();
                        showToast(data.message || 'Invalid request', 'error');
                        button.innerHTML = originalHTML;
                        button.disabled = false;
                        return;
                    }

                    if (contentType && contentType.includes('application/json')) {
                        const data = await response.json();

                        if (data.success) {
                            button.classList.toggle('active');
                            if (button.classList.contains('active')) {
                                icon.classList.remove('far');
                                icon.classList.add('fas');
                            } else {
                                icon.classList.remove('fas');
                                icon.classList.add('far');
                            }
                            showToast(data.message, 'success');

                            if (typeof window.updateWishlistCount === 'function') {
                                window.updateWishlistCount(data.wishlistCount);
                            }
                        } else {
                            showToast(data.message || 'Error updating wishlist', 'error');
                        }
                    } else {
                        showToast('Please login to manage your wishlist', 'error');
                        setTimeout(() => {
                            showLoginModal();
                        }, 1500);
                    }

                    button.innerHTML = originalHTML;
                    button.disabled = false;
                })
                .catch(error => {
                    console.error('Error:', error);
                    showToast('Network error. Please check your connection.', 'error');
                    button.innerHTML = originalHTML;
                    button.disabled = false;
                });
        }

        // Add to cart function with improved error handling
        function addToCart(productId, button) {
            const originalText = button.innerHTML;

            button.disabled = true;
            button.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

            fetch('/cart/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ productId: productId, quantity: 1 })
                })
                .then(async response => {
                    const contentType = response.headers.get('content-type');

                    if (response.status === 401) {
                        showToast('Please login to add items to cart', 'error');
                        setTimeout(() => {
                            showLoginModal();
                        }, 1500);
                        button.innerHTML = originalText;
                        button.disabled = false;
                        return;
                    }

                    if (response.status === 400) {
                        const data = await response.json();
                        showToast(data.message || 'Invalid request', 'error');
                        button.innerHTML = originalText;
                        button.disabled = false;
                        return;
                    }

                    if (contentType && contentType.includes('application/json')) {
                        const data = await response.json();

                        if (data.success) {
                            button.innerHTML = '<i class="fas fa-check"></i> Added!';
                            showToast('Product added to cart successfully!', 'success');

                            if (typeof window.updateCartCount === 'function') {
                                window.updateCartCount(data.cartCount);
                            }

                            setTimeout(() => {
                                button.innerHTML = originalText;
                                button.disabled = false;
                            }, 2000);
                        } else {
                            showToast(data.message || 'Error adding to cart', 'error');
                            button.innerHTML = originalText;
                            button.disabled = false;
                        }
                    } else {
                        showToast('Please login to add items to cart', 'error');
                        setTimeout(() => {
                            showLoginModal();
                        }, 1500);
                        button.innerHTML = originalText;
                        button.disabled = false;
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showToast('Network error. Please check your connection.', 'error');
                    button.innerHTML = originalText;
                    button.disabled = false;
                });
        }

        /* ==========================================================
           AJAX FILTERING (no page reload)
           Same GET route/query params as before - only the delivery
           mechanism changed from full form submit to fetch() + DOM swap.
           ========================================================== */

        let filterAjaxController = null;

        function getFilterParams(overridePage) {
            const params = new URLSearchParams();
            const page = overridePage || document.querySelector('#filterForm input[name="page"]').value || 1;
            params.set('page', page);

            const category = document.getElementById('category').value;
            const categoryAttribute = document.getElementById('categoryAttribute').value;
            const minPrice = document.getElementById('minPrice').value;
            const maxPrice = document.getElementById('maxPrice').value;
            const search = document.getElementById('toolbarSearch') ? document.getElementById('toolbarSearch').value : document.getElementById('search').value;
            const sortBy = document.getElementById('toolbarSortBy') ? document.getElementById('toolbarSortBy').value : document.getElementById('sortBy').value;
            const limit = document.getElementById('toolbarLimit') ? document.getElementById('toolbarLimit').value : document.getElementById('limit').value;

            if (category) params.set('category', category);
            if (categoryAttribute) params.set('categoryAttribute', categoryAttribute);
            if (minPrice) params.set('minPrice', minPrice);
            if (maxPrice) params.set('maxPrice', maxPrice);
            if (search) params.set('search', search);
            if (sortBy) params.set('sortBy', sortBy);
            if (limit) params.set('limit', limit);

            return params;
        }

        function applyFilters(resetPage) {
            const params = getFilterParams(resetPage ? 1 : null);
            loadProducts(params);
        }

        function loadProducts(params, pushHistory = true) {
            const productsContainer = document.getElementById('productsContainer');
            const sidebar = document.getElementById('filtersSidebar');

            if (filterAjaxController) {
                filterAjaxController.abort();
            }
            filterAjaxController = new AbortController();

            productsContainer.classList.add('ajax-loading');

            const url = '/?' + params.toString();

            fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    signal: filterAjaxController.signal
                })
                .then(response => response.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');

                    const newProducts = doc.getElementById('productsContainer');
                    const newResultsCount = doc.getElementById('resultsCount');
                    const newActiveFiltersGroup = doc.getElementById('activeFiltersGroup');

                    if (newProducts) {
                        productsContainer.innerHTML = newProducts.innerHTML;
                    }
                    if (newResultsCount) {
                        document.getElementById('resultsCount').innerHTML = newResultsCount.innerHTML;
                    }
                    if (newActiveFiltersGroup) {
                        const currentGroup = document.getElementById('activeFiltersGroup');
                        currentGroup.innerHTML = newActiveFiltersGroup.innerHTML;
                        currentGroup.style.display = newActiveFiltersGroup.style.display === 'none' ? 'none' : '';
                    }

                    if (pushHistory) {
                        window.history.pushState({}, '', url + '#products');
                    }

                    attachProductContainerEvents();
                    productsContainer.classList.remove('ajax-loading');
                })
                .catch(error => {
                    if (error.name === 'AbortError') return;
                    console.error('Error loading products:', error);
                    showToast('Could not load products. Please try again.', 'error');
                    productsContainer.classList.remove('ajax-loading');
                });
        }

        // Re-bind pagination links after products are swapped in
        function attachProductContainerEvents() {
            document.querySelectorAll('.ajax-page-link').forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    const page = this.getAttribute('data-page');
                    const params = getFilterParams(page);
                    loadProducts(params);
                    window.scrollTo({ top: document.getElementById('products').offsetTop - 20, behavior: 'smooth' });
                });
            });

            const clearBtn = document.getElementById('clearFiltersBtn');
            if (clearBtn) {
                clearBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    clearAllFilters();
                });
            }
        }

        // Function to clear search field
        function clearSearchField() {
            const searchInput = document.getElementById('toolbarSearch');
            searchInput.value = '';
            searchInput.focus();
            toggleClearButton();
            applyFilters(true);
        }

        // Function to toggle clear button visibility
        function toggleClearButton() {
            const searchInput = document.getElementById('toolbarSearch');
            const clearButton = document.getElementById('clearSearch');

            if (searchInput.value.trim() !== '') {
                clearButton.style.display = 'block';
            } else {
                clearButton.style.display = 'none';
            }
        }

        // Function to handle search while typing with debounce
        let searchTimeout;

        function handleSearchInput() {
            toggleClearButton();
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                applyFilters(true);
            }, 500);
        }

        // "All Categories" link - clears both category and attribute
        function selectFilter(filterName, value, el) {
            const hiddenInput = document.getElementById(filterName);
            if (hiddenInput) hiddenInput.value = value;

            if (filterName === 'category') {
                const attrInput = document.getElementById('categoryAttribute');
                if (attrInput) attrInput.value = '';
            }

            if (el) {
                const tree = document.getElementById('categoryList');
                if (tree) {
                    tree.querySelectorAll('.filter-link').forEach(a => a.classList.remove('active'));
                }
                el.classList.add('active');
            }

            applyFilters(true);
        }

        // Clicking a Category name filters by that category only
        // (clears any previously selected attribute)
        function selectCategory(categoryId, el) {
            document.getElementById('category').value = categoryId;
            document.getElementById('categoryAttribute').value = '';

            const tree = document.getElementById('categoryList');
            if (tree) {
                tree.querySelectorAll('.filter-link').forEach(a => a.classList.remove('active'));
            }
            if (el) el.classList.add('active');

            applyFilters(true);
        }

        // Clicking an Attribute (nested under a Category) filters by
        // both that category and that attribute together
        function selectCategoryAttribute(categoryId, attr, el) {
            document.getElementById('category').value = categoryId;
            document.getElementById('categoryAttribute').value = attr;

            const tree = document.getElementById('categoryList');
            if (tree) {
                tree.querySelectorAll('.filter-link').forEach(a => a.classList.remove('active'));
            }
            if (el) el.classList.add('active');

            applyFilters(true);
        }

        // Function to remove filter
        function removeFilter(filterName) {
            if (filterName === 'search' && document.getElementById('toolbarSearch')) {
                document.getElementById('toolbarSearch').value = '';
            }
            const el = document.getElementById(filterName);
            if (el) el.value = '';

            if (filterName === 'category') {
                const attrInput = document.getElementById('categoryAttribute');
                if (attrInput) attrInput.value = '';
            }

            if (filterName === 'category' || filterName === 'categoryAttribute') {
                const tree = document.getElementById('categoryList');
                if (tree) {
                    tree.querySelectorAll('.filter-link').forEach((a, idx) => a.classList.toggle('active', idx === 0));
                }
            }

            applyFilters(true);
        }

        // Function to remove price filter
        function removePriceFilter() {
            document.getElementById('minPrice').value = '';
            document.getElementById('maxPrice').value = '';
            if (priceSlider) priceSlider.set([0, 5000]);
            applyFilters(true);
        }

        // Clear all filters at once
        function clearAllFilters() {
            document.getElementById('category').value = '';
            document.getElementById('categoryAttribute').value = '';
            document.getElementById('minPrice').value = '';
            document.getElementById('maxPrice').value = '';
            if (document.getElementById('toolbarSearch')) document.getElementById('toolbarSearch').value = '';
            if (document.getElementById('toolbarSortBy')) document.getElementById('toolbarSortBy').value = 'oldest';
            if (document.getElementById('toolbarLimit')) document.getElementById('toolbarLimit').value = '30';

            const tree = document.getElementById('categoryList');
            if (tree) {
                tree.querySelectorAll('.filter-link').forEach(a => a.classList.remove('active'));
                const allCategoriesLink = tree.querySelector('.filter-link');
                if (allCategoriesLink) allCategoriesLink.classList.add('active');
            }

            if (priceSlider) priceSlider.set([0, 5000]);

            applyFilters(true);
        }

        // Price range slider (noUiSlider)
        let priceSlider = null;

        function initPriceSlider() {
            const sliderEl = document.getElementById('priceRangeSlider');
            if (!sliderEl || typeof noUiSlider === 'undefined') return;

            const startMin = parseInt(document.getElementById('minPrice').value, 10) || 0;
            const startMax = parseInt(document.getElementById('maxPrice').value, 10) || 5000;

            priceSlider = noUiSlider.create(sliderEl, {
                start: [startMin, startMax],
                connect: true,
                range: { min: 0, max: 5000 },
                step: 10
            });

            priceSlider.on('update', function(values) {
                const minVal = Math.round(values[0]);
                const maxVal = Math.round(values[1]);
                document.getElementById('priceMinLabel').textContent = minVal;
                document.getElementById('priceMaxLabel').textContent = maxVal;
                document.getElementById('minPrice').value = minVal;
                document.getElementById('maxPrice').value = maxVal;
            });
        }

        function applyPriceFilter() {
            applyFilters(true);
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            toggleClearButton();

            initPriceSlider();

            const searchInput = document.getElementById('toolbarSearch');
            if (searchInput) {
                searchInput.addEventListener('input', handleSearchInput);

                searchInput.addEventListener('keyup', function(e) {
                    if (e.key === 'Enter') {
                        clearTimeout(searchTimeout);
                        applyFilters(true);
                    }
                });
            }

            const clearSearchBtn = document.getElementById('clearSearch');
            if (clearSearchBtn) {
                clearSearchBtn.addEventListener('click', clearSearchField);
            }

            const sortBySelect = document.getElementById('toolbarSortBy');
            const limitSelect = document.getElementById('toolbarLimit');

            if (sortBySelect) {
                sortBySelect.addEventListener('change', function() {
                    applyFilters(true);
                });
            }

            if (limitSelect) {
                limitSelect.addEventListener('change', function() {
                    applyFilters(true);
                });
            }

            const filterForm = document.getElementById('filterForm');
            if (filterForm) {
                filterForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    applyFilters(true);
                });
            }

            window.addEventListener('popstate', function() {
                const params = new URLSearchParams(window.location.search);
                loadProducts(params, false);
            });

            attachProductContainerEvents();

            const savedWishlist = localStorage.getItem('wishlistData');
            if (savedWishlist) {
                try {
                    const wishlistData = JSON.parse(savedWishlist);
                    document.querySelectorAll('.wishlist-btn').forEach(btn => {
                        const productId = btn.getAttribute('data-product-id');
                        if (wishlistData.includes(productId)) {
                            btn.classList.add('active');
                            const icon = btn.querySelector('i');
                            icon.classList.remove('far');
                            icon.classList.add('fas');
                        }
                    });
                } catch (error) {
                    console.error('Error parsing wishlist data:', error);
                }
            }
        });
    </script>

    <!-- Bootstrap JS for modal -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
<%- include("../partials/user/footer.ejs") %>