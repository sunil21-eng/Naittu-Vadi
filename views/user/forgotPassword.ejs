<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: #fff;
            color: #111;
        }

        /* Renamed container to avoid Bootstrap conflict */
        .forgot-container {
            max-width: 500px;
            margin: 5rem auto;
            padding: 1rem;
            text-align: center;
        }

        h2 {
            font-weight: bold;
            margin-bottom: 1rem;
        }

        p {
            color: #666;
            margin-bottom: 2rem;
        }

        form {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1rem;
        }

        input[type="email"] {
            width: 100%;
            max-width: 350px;
            padding: 0.8rem;
            border-radius: 8px;
            border: 1px solid #ddd;
            font-size: 0.9rem;
            text-align: left;
        }

        /* Button renamed earlier to avoid .btn-primary conflict */
        .forgot-btn {
            background-color: #4a60e0;
            color: white;
            padding: 0.8rem 2rem;
            border: none;
            border-radius: 20px;
            font-size: 0.9rem;
            cursor: pointer;
            width: 100%;
            max-width: 350px;
        }

        .forgot-btn:hover {
            background-color: #3c4bb8;
        }

        .signin-link {
            font-size: 0.85rem;
            margin-top: 1rem;
        }

        .signin-link a {
            color: #4a60e0;
            text-decoration: none;
        }
    </style>
</head>

<body>

    <!-- Header -->
    <%- include('../partials/user/header') %>

    <!-- Main content -->
    <main>
        <div class="forgot-container">
            <h2>Forgot your password?</h2>
            <p>Enter the email address associated with your account, and we'll send you a link to reset your password.</p>

            <% if (typeof error !== "undefined") { %>
                <p style="color: red;">
                    <%= error %>
                </p>
            <% } %>

            <form action="/forgotPassword" method="POST">
                <input type="email" name="email" placeholder="Email" required>
                <button type="submit" class="forgot-btn">Send OTP</button>
            </form>

            <p class="signin-link">Remember your password? <a href="/login">Sign In</a></p>
        </div>
    </main>

    <!-- Footer -->
    <%- include('../partials/user/footer') %>

</body>

</html>