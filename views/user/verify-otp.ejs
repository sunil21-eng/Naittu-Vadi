<body>
    <!-- Header -->
    <%- include('../partials/user/header') %>

    <!-- Main OTP Verification Form -->
    <main class="otp-verify-container">
        <div class="logo">
            <h1>Nattuvedi</h1>
        </div>
        
        <div class="form-title">
            <h2>Verify OTP</h2>
            <p>Enter the verification code sent to your email address.</p>
        </div>
        
        <div id="message" class="message"></div>
        <div id="successMessage" class="message"></div>
        
        <form id="verifyOtpForm">
            <div class="otp-container">
                <input type="text" class="otp-input" id="digit1" maxlength="1" inputmode="numeric" autocomplete="off">
                <input type="text" class="otp-input" id="digit2" maxlength="1" inputmode="numeric" autocomplete="off">
                <input type="text" class="otp-input" id="digit3" maxlength="1" inputmode="numeric" autocomplete="off">
                <input type="text" class="otp-input" id="digit4" maxlength="1" inputmode="numeric" autocomplete="off">
                <input type="text" class="otp-input" id="digit5" maxlength="1" inputmode="numeric" autocomplete="off">
                <input type="text" class="otp-input" id="digit6" maxlength="1" inputmode="numeric" autocomplete="off">
            </div>
            
            <button type="submit" class="verify-otp-btn">Verify OTP</button>
        </form>
        
        <div class="resend-link">
            Didn't receive the code? <a id="resendLink" href="javascript:void(0)" onclick="resendOtp()" class="disabled">Resend OTP</a>
            <span id="countdown" class="countdown"></span>
        </div>
    </main>

    <!-- Footer -->
    <%- include('../partials/user/footer') %>

    <script>
        // ---------- OTP input navigation & backspace handling ----------
        const inputs = document.querySelectorAll('.otp-input');

        inputs.forEach((input, index) => {
            // Auto-advance on input
            input.addEventListener('input', (e) => {
                const value = e.target.value;
                if (value.length === 1 && index < inputs.length - 1) {
                    inputs[index + 1].focus();
                }
                // Auto-submit if all filled
                const allFilled = Array.from(inputs).every(inp => inp.value.length === 1);
                if (allFilled) {
                    document.getElementById('verifyOtpForm').dispatchEvent(new Event('submit', {cancelable: true}));
                }
            });

            // Handle backspace: if field is empty, move to previous
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && input.value === '' && index > 0) {
                    inputs[index - 1].focus();
                }
            });
        });

        // ---------- Form submission ----------
        document.getElementById('verifyOtpForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            // Get the complete OTP
            const otp = Array.from(inputs).map(input => input.value).join('');
                
            if (otp.length !== 6) {
                showMessage('Please enter the complete 6-digit OTP', 'error');
                return;
            }
            
            try {
                const response = await fetch('/verify-otp', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ otp })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    // Show success message and redirect after a visible delay
                    showSuccessMessage(data.message || 'OTP verified successfully! Redirecting...');
                    // Delay increased to 2 seconds so user can definitely read the message
                    setTimeout(() => {
                        window.location.href = data.redirectUrl || '/login';
                    }, 2000);
                } else {
                    showMessage(data.message || 'Invalid or expired OTP', 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showMessage('Network error. Please try again.', 'error');
            }
        });
        
        // ---------- Resend OTP functionality ----------
        let canResend = false;
        let countdownTime = 60;
        
        function startCountdown() {
            const countdownEl = document.getElementById('countdown');
            const resendLink = document.getElementById('resendLink');
            
            countdownEl.textContent = ` (${countdownTime}s)`;
            resendLink.classList.add('disabled');
            canResend = false;
            
            const countdownInterval = setInterval(() => {
                countdownTime--;
                countdownEl.textContent = ` (${countdownTime}s)`;
                
                if (countdownTime <= 0) {
                    clearInterval(countdownInterval);
                    countdownEl.textContent = '';
                    resendLink.classList.remove('disabled');
                    canResend = true;
                    countdownTime = 60; // Reset for next time
                }
            }, 1000);
        }
        
        async function resendOtp() {
            if (!canResend) return;
            
            try {
                const response = await fetch('/resend-otp', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                
                const data = await response.json();
                
                if (data.success) {
                    showSuccessMessage('New OTP sent to your email');
                    canResend = false;
                    startCountdown();
                } else {
                    showMessage(data.message || 'Failed to resend OTP', 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showMessage('Network error. Please try again.', 'error');
            }
        }
        
        // ---------- Message helpers ----------
        function showMessage(text, type) {
            const messageEl = document.getElementById('message');
            messageEl.textContent = text;
            messageEl.className = `message ${type}`;
            messageEl.style.display = 'block';
            
            setTimeout(() => {
                messageEl.style.display = 'none';
            }, 5000);
        }
        
        function showSuccessMessage(text) {
            const successMessageEl = document.getElementById('successMessage');
            successMessageEl.textContent = text;
            successMessageEl.className = 'message success';
            successMessageEl.style.display = 'block';
            
            setTimeout(() => {
                successMessageEl.style.display = 'none';
            }, 5000);
        }
        
        // ---------- Initialisation ----------
        window.onload = function() {
            startCountdown();
            inputs[0].focus();
        };
    </script>
</body>
</html>